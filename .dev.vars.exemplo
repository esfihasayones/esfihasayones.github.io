DONO_EMAIL=
# Produção: o painel só aceita o JWT do Cloudflare Access (cabeçalho Cf-Access-Jwt-Assertion).
# ACCESS_EQUIPE é o nome do time (o que vem antes de .cloudflareaccess.com).
# ACCESS_AUD é o "Application Audience (AUD) Tag" da aplicação no Access.
ACCESS_EQUIPE=
ACCESS_AUD=
# Só em desenvolvimento local: libera /api/painel sem login. Os testes de API precisam dele.
# Nunca configure isto em produção.
DEV_SEM_LOGIN=1
